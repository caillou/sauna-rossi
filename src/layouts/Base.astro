---
import "@fontsource/abril-fatface/400.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/400-italic.css";
import "@fontsource/archivo-narrow/400.css";
import "@fontsource/archivo-narrow/500.css";
import "@fontsource/archivo-narrow/600.css";
import "@fontsource/archivo-narrow/700.css";
import { getImage } from "astro:assets";
import abrilLatin400 from "@fontsource/abril-fatface/files/abril-fatface-latin-400-normal.woff2?url";
import narrowLatin400 from "@fontsource/archivo-narrow/files/archivo-narrow-latin-400-normal.woff2?url";
import narrowLatin600 from "@fontsource/archivo-narrow/files/archivo-narrow-latin-600-normal.woff2?url";
import volunteerPhoto from "../assets/volunteer.jpg";

interface Props {
  title: string;
  description?: string;
  // Error pages: no canonical, no Open Graph, not indexed.
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Share image: 1200x630 crop of the volunteer photo, not the hero.
const ogImage = await getImage({
  src: volunteerPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpg",
});
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="de_CH" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        {description && (
          <meta property="og:description" content={description} />
        )}
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link
      rel="preload"
      href={abrilLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      /* Only pages with the header use Archivo Narrow above the fold. */
      !noindex && (
        <>
          <link
            rel="preload"
            href={narrowLatin400}
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href={narrowLatin600}
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="column">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f2efe6;
    --ink: #17171a;
    --red: #d8412a;
    --blue: #abc1ff;
    --placeholder: #cdcac1;
    --gutter: clamp(20px, 6vw, 64px);
    --max: 1080px;
    --display: "Abril Fatface", serif;
    --body: Archivo, sans-serif;
    --narrow: "Archivo Narrow", sans-serif;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--red);
  }

  a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
</style>

<style>
  .column {
    max-width: var(--max);
    margin: 0 auto;
  }
</style>
