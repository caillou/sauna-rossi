---
import { newLocation } from "../content/site";
import Rich from "./Rich.astro";
---

<section>
  <div>
    <p class="label">{newLocation.label}</p>
    <h2>{newLocation.title}</h2>
  </div>
  <div class="body">
    {newLocation.paragraphs.map((segments) => (
      <p>
        <Rich segments={segments} />
      </p>
    ))}
  </div>
</section>

<style>
  section {
    padding: clamp(44px, 7vw, 64px) var(--gutter) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 24px clamp(28px, 4vw, 48px);
    align-items: start;
  }

  p {
    margin: 0;
  }

  .label {
    font-family: var(--narrow);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }

  h2 {
    margin: 10px 0 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 50px);
    line-height: 0.95;
    text-wrap: pretty;
  }

  .body {
    font-size: 20px;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
