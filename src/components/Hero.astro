---
import { Picture } from "astro:assets";
import photo from "../assets/buckets.jpeg";
import { hero } from "../content/site";
---

<figure>
  <Picture
    src={photo}
    alt={hero.alt}
    class="photo"
    formats={["avif", "webp"]}
    widths={[400, 640, 800, 1080, 1600, 2160]}
    sizes="(min-width: 1080px) 1080px, max(100vw, 400px)"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  figure {
    margin: 44px 0 0;
    height: clamp(300px, 46vw, 620px);
    overflow: hidden;
    background: var(--placeholder);
  }

  /* The class lands on the img. Take the picture out of the box tree so the
     img's height: 100% resolves against the figure. */
  figure :global(picture) {
    display: contents;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }
</style>
