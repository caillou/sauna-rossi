---
import { Picture } from "astro:assets";
import photo from "../assets/nacht-nelly-rodriguez.jpg";
import { hero } from "../content/site";
---

<figure>
  <Picture
    src={photo}
    alt={hero.alt}
    class="photo"
    formats={["avif", "webp"]}
    widths={[400, 640, 800, 1080, 1440, 1800]}
    sizes="(min-width: 1080px) 1080px, 100vw"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  figure {
    margin: 44px 0 0;
    /* Loading state. The sky in the photo is black, so the two blend. */
    background: #17171a;
  }

  /* Uncropped: the height follows from the img's width and height attributes. */
  .photo {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
