---
import { header } from "../content/site";
import Rich from "./Rich.astro";
---

<header>
  <p class="presenter">
    <Rich segments={header.presenter} />
  </p>
  <p class="project">{header.project}</p>
</header>

<style>
  header {
    padding: clamp(32px, 6vw, 56px) var(--gutter) 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
    font-family: var(--narrow);
  }

  p {
    margin: 0;
  }

  .presenter {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .project {
    font-size: 14px;
    line-height: 1.35;
    text-align: right;
    max-width: 230px;
    opacity: 0.75;
  }
</style>
