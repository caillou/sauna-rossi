---
import { Picture } from "astro:assets";
import photo from "../assets/volunteer.jpg";
import { volunteer } from "../content/site";
---

<section>
  <div class="text">
    <div>
      <h2>{volunteer.title}</h2>
      <p class="pitch">{volunteer.text}</p>
    </div>
    <div class="how">
      <p class="how-label">{volunteer.howLabel}</p>
      <p class="how-text">{volunteer.how}</p>
    </div>
  </div>
  <figure>
    <Picture
      src={photo}
      alt={volunteer.alt}
      class="photo"
      formats={["avif", "webp"]}
      widths={[480, 640, 800, 960, 1200]}
      sizes="(min-width: 1334px) 840px, (min-width: 900px) 63vw, (min-width: 840px) 72vw, max(100vw, 480px)"
    />
  </figure>
</section>

<style>
  section {
    margin: clamp(40px, 6vw, 56px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    background: var(--ink);
  }

  .text {
    color: var(--paper);
    padding: clamp(38px, 5vw, 56px) clamp(20px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 30px;
    justify-content: center;
  }

  h2 {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 50px);
    line-height: 1;
    color: var(--blue);
  }

  .pitch {
    margin: 16px 0 0;
    font-size: 19px;
    line-height: 1.45;
  }

  .how {
    font-family: var(--narrow);
  }

  .how-label {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .how-text {
    margin: 8px 0 0;
    font-size: clamp(26px, 3.6vw, 34px);
    font-weight: 700;
    line-height: 1.12;
  }

  figure {
    margin: 0;
    min-height: clamp(320px, 42vw, 560px);
    overflow: hidden;
    background: var(--placeholder);
  }

  /* The class lands on the img. Take the picture out of the box tree so the
     img's height: 100% resolves against the stretched figure. */
  figure :global(picture) {
    display: contents;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    display: block;
  }
</style>
