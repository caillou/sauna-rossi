---
import { footer } from "../content/site";
import Rich from "./Rich.astro";

// Lines 1+2, 3+4, 5+6. The browser must never break between two items, or a
// dot lands at a line edge, so a line never wraps once its items share a row.
const lines = [footer.slice(0, 2), footer.slice(2, 4), footer.slice(4, 6)];
---

<footer>
  {lines.map((line) => (
    <p class="line">
      {line.map((item, i) => (
        <>
          {i > 0 && <span class="dot">{" · "}</span>}
          <span>
            <Rich segments={item} />
          </span>
        </>
      ))}
    </p>
  ))}
</footer>

<style>
  footer {
    padding: clamp(44px, 7vw, 64px) var(--gutter) 64px;
    font-family: var(--narrow);
    font-size: 13px;
    line-height: 1.6;
    opacity: 0.72;
    text-align: center;
    display: flex;
    flex-direction: column;
    row-gap: 4px;
  }

  /* One item per row, no dots. A long item may wrap inside itself. */
  .line {
    margin: 0;
    display: flex;
    flex-direction: column;
    row-gap: 4px;
  }

  .dot {
    display: none;
  }

  @media (min-width: 520px) {
    .line {
      display: block;
      white-space: nowrap;
    }

    .dot {
      display: inline;
    }
  }
</style>
