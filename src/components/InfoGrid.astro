---
import { info } from "../content/site";
import Rich from "./Rich.astro";
---

<section>
  {info.map((item) => (
    <div class="item">
      <h2>{item.label}</h2>
      <div class="body">
        {item.paragraphs.map((segments) => (
          <p>
            <Rich segments={segments} />
          </p>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  section {
    padding: clamp(38px, 6vw, 52px) var(--gutter) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 40px clamp(28px, 4vw, 48px);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  h2 {
    margin: 0;
    font-family: var(--narrow);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }

  .body {
    font-size: 20px;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  p {
    margin: 0;
  }
</style>
