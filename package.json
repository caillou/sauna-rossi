{
  "name": "sauna-rossi",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "deploy": "pnpm build && gh-pages -d dist -t -b gh-pages",
    "preview": "astro preview",
    "astro": "astro",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.2.0",
    "@fontsource/archivo": "^5.2.0",
    "@fontsource/archivo-narrow": "^5.2.0",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "gh-pages": "^6.3.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
